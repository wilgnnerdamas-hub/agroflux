# Copie para .env (fora do git). Nunca versione a secret da carteira.
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
SOLANA_RPC_URL=https://api.devnet.solana.com
# Secret da carteira pagadora da Devnet em base58. Gere com: npm run wallet:new
SOLANA_FEE_PAYER_SECRET=
# Diretório dos dados (db.json e uploads)
DATA_DIR=./data
# Habilita POST /api/v1/demo/reset
DEMO_RESET_ENABLED=false
# Função B (cessão tokenizada, §6.4). Preencha com: npm run setup:assignment -- --escrow <PROGRAM_ID>
ASSIGNMENT_ENABLED=false
DEMO_DISTRIBUTOR_SECRET=
DEMO_DISTRIBUTOR_B_SECRET=
DEMO_DISTRIBUTOR_C_SECRET=
# v1.3: tesouraria da AgroFlux (só o endereço público; padrão = constante do programa de escrow).
AGROFLUX_TREASURY=8j5HxEYAX1hFToDWjBQsvvKYafAc67qr76xjq5K53XVq
# v1.3: CDI da API do Banco Central (padrão). Use CDI_SOURCE=manual para não consultar a rede.
CDI_SOURCE=bcb
DEMO_FUNDER_SECRET=
DEMO_FUNDER_B_SECRET=
DEMO_FUNDER_C_SECRET=
TBRL_MINT=
ESCROW_PROGRAM_ID=
